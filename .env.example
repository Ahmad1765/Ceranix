# Copy this file to .env and fill in values. EXPO_PUBLIC_* vars are exposed to
# the client at build time; everything else is server-only.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry crash + error reporting. Leave blank to disable (all reporting becomes
# a no-op). The DSN is safe to expose to the client. Get it from
# Sentry → Project Settings → Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=

# Set to 1 to send events from a DEV build (expo start) so you can verify the
# Sentry connection locally. Leave blank/unset in normal dev + production so the
# dashboard isn't flooded with development noise.
EXPO_PUBLIC_SENTRY_DEBUG=

# PostHog product analytics (EU cloud). Leave blank to disable (all analytics
# helpers become no-ops). Get the key from PostHog → Project Settings.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Stripe — frontend uses publishable key only. The secret key is set as a
# Supabase function secret (see below), never bundled in the app.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# ---------------------------------------------------------------------------
# Stripe secret + supabase function setup (run once, NOT committed to repo):
#
#   supabase secrets set STRIPE_SECRET_KEY=sk_test_replace_me
#   supabase functions deploy create-checkout-session
#
#   supabase secrets set POSTHOG_KEY=phc_xxx
#   supabase secrets set POSTHOG_HOST=https://eu.i.posthog.com
#
# Test card: 4242 4242 4242 4242 — any future date, any CVC.
