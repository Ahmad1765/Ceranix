# Copy to `.env.test` and adjust for local runs.
# CI sets these via the e2e-tests workflow `env:` block.
#
# Tests never hit a real backend — every Supabase/Stripe request is intercepted
# by Playwright. These values only need to be syntactically valid so the web
# bundle builds and the supabase-js client can emit requests we can route.

# Hostname Playwright matches in route handlers (helpers/supabase-mock.ts).
# Anything ending in `.supabase.test` works.
EXPO_PUBLIC_SUPABASE_URL=https://e2e.supabase.test

# Any non-empty string — supabase-js sends it as the apikey/Authorization
# header. We don't validate it.
EXPO_PUBLIC_SUPABASE_ANON_KEY=e2e-anon-key

# Leave blank or unset to keep Stripe in DEMO mode (no real Checkout redirect).
# The payment flow is tested in demo mode; setting a `pk_test_...` key forces
# real Checkout, which we don't test from the client side.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional: override the URL Playwright serves the built bundle on.
# Defaults to http://127.0.0.1:4173 (see playwright.config.ts).
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173
